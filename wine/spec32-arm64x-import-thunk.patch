From 7bc6ae2d566b2a0ca40cc12c304608160bff626a Mon Sep 17 00:00:00 2001
From: TimmyTurner51 <timmy@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:15:33 -0600
Subject: [PATCH] winebuild: emit x86_64-style hotpatch prologues for ARM64EC import thunks

---
 tools/winebuild/spec32.c | 171 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 171 insertions(+)

diff --git a/tools/winebuild/spec32.c b/tools/winebuild/spec32.c
index 062e65c..5c34b40 100644
--- a/tools/winebuild/spec32.c
+++ b/tools/winebuild/spec32.c
@@ -1430,6 +1430,159 @@ void output_def_file( DLLSPEC *spec, struct exports *exports, int import_only )
 }
 
 
+#define IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG 10
+#define IMAGE_DIRECTORY_ENTRY_IAT         12
+
+static unsigned int get_le16( const unsigned char *p ) { return p[0] | (p[1] << 8); }
+static unsigned int get_le32( const unsigned char *p ) { return get_le16( p ) | (get_le16( p + 2 ) << 16); }
+
+static unsigned char *pe_rva_ptr( unsigned char *data, size_t size, const unsigned char *sec,
+                                  unsigned int nb_sec, unsigned int rva, unsigned int len )
+{
+    unsigned int i;
+
+    for (i = 0; i < nb_sec; i++, sec += 40)
+    {
+        unsigned int va = get_le32( sec + 12 ), raw_size = get_le32( sec + 16 ), raw_ptr = get_le32( sec + 20 );
+        if (rva < va || rva - va >= raw_size || raw_size - (rva - va) < len) continue;
+        if (raw_ptr + (rva - va) + (size_t)len > size) return NULL;
+        return data + raw_ptr + (rva - va);
+    }
+    return NULL;
+}
+
+/*******************************************************************
+ *         fixup_arm64x_import_thunks
+ *
+ * On x86_64, -import exports point to a thunk with a hotpatch prolog (see output_exports).
+ * On ARM64EC the linker exports its own x64 import thunk instead, a bare "jmp *__imp_x(%rip)"
+ * in a 16-byte slot, which code inspecting export prologues takes for a hook.  Give those
+ * thunks the same shape as on x86_64.
+ */
+static int fixup_arm64x_import_thunks( unsigned char *data, size_t size )
+{
+    static const unsigned char prolog[8] = { 0x48, 0x8d, 0xa4, 0x24, 0x00, 0x00, 0x00, 0x00 };
+    unsigned int nt, nb_sec, opt, nb_dirs, dirs, lc_rva, lc_size, dvrt_rva, dvrt_size;
+    unsigned int chpe_rva, map_rva, map_count, exp_rva = 0, exp_size = 0, iat_rva, iat_size;
+    unsigned int i, j, pos, nb_funcs, funcs_rva, count = 0;
+    unsigned long long image_base, chpe_va;
+    unsigned char *sec, *lc, *dvrt, *chpe, *map, *exp, *funcs;
+
+    if (size < 0x40) return 0;
+    nt = get_le32( data + 0x3c );
+    if (nt > size - 0x108 || memcmp( data + nt, "PE\0\0", 4 )) return 0;
+    if (get_le16( data + nt + 4 ) != IMAGE_FILE_MACHINE_ARM64) return 0;
+    nb_sec = get_le16( data + nt + 6 );
+    opt = nt + 24;
+    if (get_le16( data + opt ) != IMAGE_NT_OPTIONAL_HDR64_MAGIC) return 0;
+    sec = data + opt + get_le16( data + nt + 20 );
+    if ((size_t)(sec - data) + nb_sec * 40 > size) return 0;
+    image_base = get_le32( data + opt + 24 ) | ((unsigned long long)get_le32( data + opt + 28 ) << 32);
+    nb_dirs = get_le32( data + opt + 108 );
+    dirs = opt + 112;
+    if (nb_dirs <= IMAGE_DIRECTORY_ENTRY_IAT) return 0;
+
+    lc_rva = get_le32( data + dirs + 8 * IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG );
+    if (!(lc = pe_rva_ptr( data, size, sec, nb_sec, lc_rva, 4 ))) return 0;
+    lc_size = get_le32( lc );
+    if (lc_size < 232 || !(lc = pe_rva_ptr( data, size, sec, nb_sec, lc_rva, lc_size ))) return 0;
+
+    /* CHPE code map, to only touch x64 code */
+    chpe_va = get_le32( lc + 200 ) | ((unsigned long long)get_le32( lc + 204 ) << 32);
+    if (!chpe_va) return 0;
+    chpe_rva = chpe_va - image_base;
+    if (!(chpe = pe_rva_ptr( data, size, sec, nb_sec, chpe_rva, 12 ))) return 0;
+    map_rva = get_le32( chpe + 4 );
+    map_count = get_le32( chpe + 8 );
+    if (!(map = pe_rva_ptr( data, size, sec, nb_sec, map_rva, map_count * 8 ))) return 0;
+
+    /* the x64 view's export directory comes from the ARM64X dynamic relocations */
+    i = get_le16( lc + 228 );
+    if (!i || i > nb_sec) return 0;
+    dvrt_rva = get_le32( sec + (i - 1) * 40 + 12 ) + get_le32( lc + 224 );
+    if (!(dvrt = pe_rva_ptr( data, size, sec, nb_sec, dvrt_rva, 8 ))) return 0;
+    if (get_le32( dvrt ) != 1) return 0;
+    dvrt_size = get_le32( dvrt + 4 );
+    if (!(dvrt = pe_rva_ptr( data, size, sec, nb_sec, dvrt_rva, 8 + dvrt_size ))) return 0;
+    for (pos = 8; pos + 12 <= 8 + dvrt_size; )
+    {
+        unsigned int symbol = get_le32( dvrt + pos ), block_size = get_le32( dvrt + pos + 8 );
+        unsigned int end = pos + 12 + block_size;
+
+        pos += 12;
+        if (end > 8 + dvrt_size) break;
+        if (symbol != 6 /* IMAGE_DYNAMIC_RELOCATION_ARM64X */) { pos = end; continue; }
+        while (pos + 8 <= end)
+        {
+            unsigned int page = get_le32( dvrt + pos ), blk_end = pos + get_le32( dvrt + pos + 4 );
+            if (blk_end <= pos || blk_end > end) break;
+            for (pos += 8; pos + 2 <= blk_end; )
+            {
+                unsigned int entry = get_le16( dvrt + pos ), rva = page + (entry & 0xfff);
+                pos += 2;
+                if (!entry) continue;
+                switch ((entry >> 12) & 3)
+                {
+                case 1:  /* value */
+                    if ((entry >> 14) == 2 && pos + 4 <= blk_end)
+                    {
+                        if (rva == dirs) exp_rva = get_le32( dvrt + pos );
+                        else if (rva == dirs + 4) exp_size = get_le32( dvrt + pos );
+                    }
+                    pos += 1 << (entry >> 14);
+                    break;
+                case 2:  /* delta */
+                    pos += 2;
+                    break;
+                }
+            }
+            pos = blk_end;
+        }
+        pos = end;
+    }
+    if (!exp_rva || !(exp = pe_rva_ptr( data, size, sec, nb_sec, exp_rva, 40 ))) return 0;
+
+    iat_rva = get_le32( data + dirs + 8 * IMAGE_DIRECTORY_ENTRY_IAT );
+    iat_size = get_le32( data + dirs + 8 * IMAGE_DIRECTORY_ENTRY_IAT + 4 );
+    nb_funcs = get_le32( exp + 20 );
+    funcs_rva = get_le32( exp + 28 );
+    if (!(funcs = pe_rva_ptr( data, size, sec, nb_sec, funcs_rva, nb_funcs * 4 ))) return 0;
+
+    for (i = 0; i < nb_funcs; i++)
+    {
+        unsigned int func = get_le32( funcs + 4 * i ), target;
+        unsigned char *code, pad;
+        int rel, x64 = 0;
+
+        if (!func || (func & 15) || (func >= exp_rva && func < exp_rva + exp_size)) continue;
+        for (j = 0; j < map_count; j++)
+        {
+            unsigned int start = get_le32( map + 8 * j ), len = get_le32( map + 8 * j + 4 );
+            if ((start & 3) == 2 && func >= (start & ~3) && func + 16 <= (start & ~3) + len) x64 = 1;
+        }
+        if (!x64 || !(code = pe_rva_ptr( data, size, sec, nb_sec, func, 16 ))) continue;
+        if (code[0] != 0xff || code[1] != 0x25) continue;
+        pad = code[6];
+        if (pad && pad != 0xcc) continue;
+        for (j = 7; j < 16; j++) if (code[j] != pad) break;
+        if (j < 16) continue;
+        rel = (int)get_le32( code + 2 );
+        target = func + 6 + rel;
+        if (target < iat_rva || target >= iat_rva + iat_size || (target & 7)) continue;
+        rel -= sizeof(prolog);
+        memcpy( code, prolog, sizeof(prolog) );
+        code[8] = 0xff;
+        code[9] = 0x25;
+        code[10] = rel;
+        code[11] = rel >> 8;
+        code[12] = rel >> 16;
+        code[13] = rel >> 24;
+        code[14] = code[15] = pad;
+        count++;
+    }
+    return count;
+}
+
 /*******************************************************************
  *         make_builtin_files
  */
@@ -1471,6 +1624,24 @@ void make_builtin_files( struct strarray files )
                     write( fd, &dll_charact, sizeof(dll_charact) );
                 }
             }
+
+            {
+                struct stat st;
+                unsigned char *data;
+
+                if (!fstat( fd, &st ) && (data = malloc( st.st_size )))
+                {
+                    lseek( fd, 0, SEEK_SET );
+                    if (read( fd, data, st.st_size ) == st.st_size &&
+                        fixup_arm64x_import_thunks( data, st.st_size ))
+                    {
+                        lseek( fd, 0, SEEK_SET );
+                        if (write( fd, data, st.st_size ) != st.st_size)
+                            fatal_perror( "%s: Cannot write", file );
+                    }
+                    free( data );
+                }
+            }
         }
         else fatal_error( "%s: Unrecognized file format\n", file );
         close( fd );
-- 
2.53.0

