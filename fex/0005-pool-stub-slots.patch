@@ -183,6 +185,98 @@ struct GuestToHostMap {
   fextl::robin_map<uint64_t, BlockEntry> BlockList;
   fextl::robin_map<uint64_t, BlockEntry> Stash;
 
+  // Pool stubs. The title keeps a pool of about half a million one-instruction stubs
+  // (an instruction and a jmp) and rewrites them millions of times a minute. Every rewrite
+  // fails the stub's SMC check, and the next run loaded a new copy of it into the code
+  // buffer, which nothing ever freed: about 1 GB a minute in the world.
+  //
+  // Each stub entry now gets up to PoolSlotsPerEntry slots, carved from arenas in this map's
+  // code buffers, and a new copy goes over the oldest one. That is safe because:
+  // - every copy is a whole translation of the same entry that checks the guest bytes when
+  //   entered, so a stale pointer that reaches a slot runs a translation of the right entry,
+  //   which recompiles if the bytes differ;
+  // - a slot is only reused with the same entry offset, so a stale pointer to the entry
+  //   (another thread's L1, an older mapping) still lands on the start of a translation;
+  // - the stash entry for the guest entry is dropped, since it may name the old copy;
+  // - exits inside an arena are never linked (ExitFunctionLink checks InPoolArena), so no
+  //   link record points into a slot. Links into a slot go away when the entry is erased,
+  //   which happens before it is compiled again;
+  // - the newest copies, which a thread may still be running, are left alone.
+  // Guarded by this map's write lock, except InPoolArena.
+  struct PoolSlot {
+    uint8_t* Host;
+    uint32_t Capacity;
+    uint32_t EntryOffset;
+    uint64_t Seq;
+  };
+  static constexpr uint32_t PoolSlotsPerEntry = 3;
+  struct PoolSlotSet {
+    std::array<PoolSlot, PoolSlotsPerEntry> Slots;
+    uint8_t Count {};
+  };
+  fextl::robin_map<uint64_t, PoolSlotSet> PoolSlots;
+  uint64_t PoolSlotSeq {};
+
+  static constexpr size_t PoolArenaSize = 8 * 1024 * 1024;
+  static constexpr uint32_t MaxPoolArenas = 512;
+  std::array<std::atomic<uintptr_t>, MaxPoolArenas> PoolArenaBase {};
+  std::atomic<uint32_t> PoolArenaCount {};
+  uint8_t* PoolArenaCursor {};
+  uint8_t* PoolArenaEnd {};
+
+  bool InPoolArena(uintptr_t Address) const {
+    const uint32_t N = PoolArenaCount.load(std::memory_order_acquire);
+    for (uint32_t i = 0; i < N; ++i) {
+      if (Address - PoolArenaBase[i].load(std::memory_order_relaxed) < PoolArenaSize) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool AddPoolArena(uint8_t* Base) {
+    const uint32_t N = PoolArenaCount.load(std::memory_order_relaxed);
+    if (N >= MaxPoolArenas) {
+      return false;
+    }
+    PoolArenaBase[N].store(reinterpret_cast<uintptr_t>(Base), std::memory_order_relaxed);
+    PoolArenaCount.store(N + 1, std::memory_order_release);
+    PoolArenaCursor = Base;
+    PoolArenaEnd = Base + PoolArenaSize;
+    return true;
+  }
+
+  // Returns the slot to write the copy into, or null with NeedArena set when a new arena is needed.
+  uint8_t* GetPoolSlot(uint64_t Rip, uint32_t Size, uint32_t EntryOffset, bool* NeedArena, bool* Reused) {
+    auto& Set = PoolSlots[Rip];
+    PoolSlot* Oldest = nullptr;
+    if (Set.Count == PoolSlotsPerEntry) {
+      Oldest = &Set.Slots[0];
+      for (auto& S : Set.Slots) {
+        if (S.Seq < Oldest->Seq) {
+          Oldest = &S;
+        }
+      }
+      if (Oldest->Capacity >= Size && Oldest->EntryOffset == EntryOffset) {
+        Oldest->Seq = ++PoolSlotSeq;
+        Stash.erase(Rip);
+        *Reused = true;
+        return Oldest->Host;
+      }
+    }
+    // A new slot. A replaced slot is abandoned with its code intact, so pointers into it stay valid.
+    const uint32_t Capacity = (std::max<uint32_t>(Size, 512) + 127) & ~127U;
+    if (!PoolArenaCursor || PoolArenaCursor + Capacity > PoolArenaEnd) {
+      *NeedArena = true;
+      return nullptr;
+    }
+    uint8_t* Host = PoolArenaCursor;
+    PoolArenaCursor += Capacity;
+    PoolSlot* Dest = Set.Count < PoolSlotsPerEntry ? &Set.Slots[Set.Count++] : Oldest;
+    *Dest = PoolSlot {Host, Capacity, EntryOffset, ++PoolSlotSeq};
+    return Host;
+  }
+
   fextl::map<uint64_t, fextl::vector<uint64_t>> CodePages;
 
   GuestToHostMap();
