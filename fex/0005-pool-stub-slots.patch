+// Writes a single-entry stub copy into one of GuestRIP's pool slots (see GuestToHostMap::GetPoolSlot).
+// Null when that is not possible; the caller then loads it into fresh code buffer memory as before.
+uint8_t* LoadIntoPoolSlot(FEXCore::Core::InternalThreadState* Thread, uint64_t GuestRIP, std::span<const uint8_t> Bytes, uint32_t EntryOffset) {
+  auto* Map = Thread->LookupCache->GetSharedMap();
+  if (!Map || !Thread->CPUBackend->IsLatestMap(Map)) {
+    return nullptr;
+  }
+  for (int Attempt = 0; Attempt < 2; ++Attempt) {
+    bool NeedArena = false;
+    {
+      auto MapLock = Map->AcquireWriteLock();
+      bool Reused = false;
+      if (uint8_t* Slot = Map->GetPoolSlot(GuestRIP, Bytes.size(), EntryOffset, &NeedArena, &Reused)) {
+        Thread->CPUBackend->OverwriteCode(Slot, Bytes);
+        FEXCore::FH6Stats::Add(Reused ? FEXCore::FH6Stats::PoolSlotReuse : FEXCore::FH6Stats::PoolSlotNew);
+        return Slot;
+      }
+    }
+    if (!NeedArena || Attempt) {
+      return nullptr;
+    }
+    // Allocating may clear the code cache, which takes the map lock, so do it unlocked.
+    uint8_t* Arena = Thread->CPUBackend->AllocateCode(FEXCore::GuestToHostMap::PoolArenaSize);
+    if (!Arena || Thread->LookupCache->GetSharedMap() != Map || !Thread->CPUBackend->IsLatestMap(Map)) {
+      return nullptr;
+    }
+    auto MapLock = Map->AcquireWriteLock();
+    if (!Map->AddPoolArena(Arena)) {
+      return nullptr;
+    }
+  }
+  return nullptr;
+}
