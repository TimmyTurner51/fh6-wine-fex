-  return {XResult.Interval.Offset, XResult.Interval.End - XResult.Interval.Offset, false};
+  LogMan::Msg::DFmt("Recovered executable VMA: {:X} - {:X} writable={}", Base, Base + Size, Writable);
+  return {Base, Size, Writable};
 }
 
